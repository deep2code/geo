# GEO 系统环境变量配置模板
# 复制为 .env 并填写实际值：cp .env.example .env

# ===== 服务配置 =====
# API 服务端口
GEO_PORT=8080

# ===== LLM 配置（可选，不配置则仅规则化预处理）=====
# OpenAI 兼容 API Key（支持 OpenAI 及国内外所有兼容模型）
GEO_LLM_KEY=
# API Base URL（默认 https://api.openai.com）
# 国内大模型示例:
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode
#   智谱GLM:  https://open.bigmodel.cn/api/paas/v4
#   DeepSeek: https://api.deepseek.com
#   Kimi:     https://api.moonshot.cn
#   豆包:     https://ark.cn-beijing.volces.com/api/v3
#   讯飞星火: https://spark-api-open.xf-yun.com/v1
#   元宝/混元: https://api.hunyuan.cloud.tencent.com/v1
#   小米:     https://api.xiaomi.com/v1
GEO_LLM_BASE=https://api.openai.com
# 模型名称（默认 gpt-4o-mini）
# 国内大模型示例:
#   通义千问: qwen-plus
#   智谱GLM:  glm-4-flash
#   DeepSeek: deepseek-chat
#   Kimi:     moonshot-v1-8k
#   豆包:     doubao-pro-32k
#   讯飞星火: generalv3.5
#   元宝/混元: hunyuan-lite
#   小米:     milm-6b
GEO_LLM_MODEL=gpt-4o-mini

# ===== 时区 =====
TZ=Asia/Shanghai
