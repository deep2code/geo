# Dockerfile.base — GEO 构建基础镜像
#
# 目标：把「重活」(Go/Node 工具链 + 依赖下载 + 依赖编译缓存) 一次性固化进基础镜像，
#       日常发布只构建 app 镜像（FROM 本镜像，仅叠加业务源码并编译业务代码），
#       从而把每次发布从「全量下载+全量编译」降到「仅编译变化的业务包」。
#
# 何时需要重建本基础镜像：
#   - go.mod / go.sum / web-app/package.json / web-app/package-lock.json 发生变化时
#   - 否则 docker 直接命中已缓存的 layer，几乎瞬时返回
# 重建命令（publish.sh 会自动执行）：
#   docker buildx build --platform linux/amd64 --load -f Dockerfile.base -t geo-build-base:latest .
#
# syntax=docker/dockerfile:1
FROM golang:1.26-alpine

# 安装 Node.js / npm（前端构建需要）；先切换 apk 到阿里云国内镜像，
# 避免 dl-cdn.alpinelinux.org 在国内的极慢下载（曾单次耗时 12 分钟）。
RUN sed -i 's#https\?://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories && \
    apk add --no-cache nodejs npm

# 国内代理加速：Go 模块走 goproxy.cn，npm 走 npmmirror。
# 这里硬编码一份，保证直接 `docker build -f Dockerfile.base` 也走国内源
# （publish.sh 给 app 镜像传的 build-arg 默认也是这两个，保持一致）。
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=off
ENV npm_config_registry=https://registry.npmmirror.com

# ===== 预热 Go 模块缓存 =====
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

# ===== 预热前端依赖 =====
COPY web-app/package.json web-app/package-lock.json ./web-app/
RUN cd web-app && npm ci

# 注：不再在基础镜像内预热 Go 编译缓存（GOCACHE）。app 镜像构建走 buildx 的持久缓存
# 挂载 /gocache 自热（首次冷编全部依赖写入 /gocache，之后增量命中），基础镜像无需重复预热。

CMD ["/bin/sh"]
